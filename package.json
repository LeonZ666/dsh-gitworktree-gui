{
  "name": "dsh-gitworktree-gui",
  "version": "0.6.0",
  "description": "Git worktree panel for DeepSeek Harness: branch/merge topology, worktrees, changes and file tree.",
  "author": "LeonZ666",
  "license": "MIT",
  "homepage": "https://github.com/LeonZ666/dsh-gitworktree-gui#readme",
  "bugs": {
    "url": "https://github.com/LeonZ666/dsh-gitworktree-gui/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "git",
    "worktree",
    "plugin",
    "sidebar",
    "topology"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeonZ666/dsh-gitworktree-gui.git"
  },
  "type": "module",
  "main": "index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    ".claude-plugin",
    "hooks",
    "types",
    "codex",
    "docs/*.md",
    "assets/readme",
    "scripts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "npm run build:codex && node --test test/*.test.js",
    "check": "node --check index.js && node --check client.js && node --check lib/core.js && node --check lib/glyphs.js && node --check codex/server.mjs && node --check codex/scripts/start.mjs && node --check codex/frontend.js && node --check scripts/build-market-index.mjs",
    "build:codex": "node scripts/build-codex.mjs",
    "panel": "node codex/scripts/start.mjs",
    "market:index": "node scripts/build-market-index.mjs",
    "market:check": "node scripts/build-market-index.mjs --check",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-plugin-market-index": "0.2.1-rc.2",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
